# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/mediassist

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS — comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:8443,http://127.0.0.1:8443,http://localhost:5173

# RAG chatbot microservice (already built separately).
# The backend proxies POST /api/assistant/chat to `${RAG_SERVICE_URL}/rag/query`.
# Leave empty to use the built-in offline fallback responder.
RAG_SERVICE_URL=
RAG_SERVICE_TIMEOUT_MS=15000

# Live-tracking tuning
DRIVER_LOCATION_STALE_SECONDS=60
AVERAGE_AMBULANCE_SPEED_KMPH=40
